# ============================================================
# AI 人格聊天平台 - 环境变量模板
# 复制此文件为 .env，填入实际值
# 注意：.env 已在 .gitignore 中，不会被提交到 Git
# ============================================================

# ============================================================
# 【必填】LLM 配置（OpenAI-compatible API）
# ============================================================

# LLM API 密钥（敏感，绝对不要提交到 Git）
OPENAI_API_KEY=

# LLM API 基础地址
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 豆包: https://ark.cn-beijing.volces.com/api/v3
# OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=

# LLM 模型名
# DeepSeek: deepseek-chat
# 通义千问: qwen-plus
# 豆包: 你的模型接入点 ID（ep-xxxxxxxx）
# OpenAI: gpt-4o-mini
OPENAI_MODEL=

# ============================================================
# 数据库配置
# ============================================================

# 数据库连接串
# 本地开发: sqlite:///./data/app.db
# 生产环境(Supabase): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# ============================================================
# Supabase 配置（生产环境必填，本地开发可留空）
# ============================================================

# 是否启用 Supabase 模式（true=生产模式，需要登录；false=本地开发免登录）
USE_SUPABASE=false

# Supabase 项目 URL
SUPABASE_URL=

# Supabase 匿名 Key（前端可见，非敏感）
SUPABASE_ANON_KEY=

# Supabase 服务角色 Key（敏感，仅后端使用，绝对不要配置到前端 VITE_* 变量）
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# CORS 配置
# ============================================================

# 允许的前端地址（生产环境必填，用于 CORS）
# 生产: https://ai-persona-chat-mu.vercel.app
# Staging: https://ai-persona-chat-qkito1k5p-ai-persona-team.vercel.app
# 本地: http://127.0.0.1:5173
FRONTEND_URL=

# ============================================================
# 图片生成配置（GK Image 2.0 / 小羽毛AI聚合平台）
# ============================================================

# 图片生成 API 基础地址
IMAGE_API_BASE_URL=https://api.lk888.ai

# 图片生成 API Key（敏感）
IMAGE_API_KEY=

# 图片生成模型名
IMAGE_MODEL=gk-image-2.0

# 图片输出目录（相对路径基于 backend/ 目录）
IMAGE_OUTPUT_DIR=data/generated_images

# 图片生成超时（秒）
IMAGE_TIMEOUT=180

# ============================================================
# 【Legacy】豆包视觉 / 火山方舟（回滚备用，当前不使用）
# 如需回滚到豆包视觉，将 image_service.py 中的 generate_image
# 重命名为 _generate_image_gk，然后将 _generate_image_doubao_legacy
# 重命名为 generate_image
# ============================================================

DOUBAO_VISION_API_KEY=
DOUBAO_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_MODEL=

# ============================================================
# 应用标识（版本信息接口使用）
# ============================================================

# 运行环境: production / staging / development
APP_ENVIRONMENT=development

# 版本号
APP_VERSION=Chat Core 2.0

# 部署 commit hash（可选，用于排查部署版本问题）
APP_COMMIT=unknown

# ============================================================
# 性能调优（一般不需要修改）
# ============================================================

# 上下文最大消息数
MAX_CONTEXT_MESSAGES=40

# LLM 请求超时（秒）
LLM_TIMEOUT=120

# 每分钟限流
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# 前端环境变量（配置在 Vercel，或本地 frontend/.env.local）
# 以下仅作参考，实际应配置在 frontend/.env.local 或 Vercel 环境变量中
# ============================================================
# VITE_USE_SUPABASE=false
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
