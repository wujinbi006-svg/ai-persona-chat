OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
DATABASE_URL=sqlite:///./data/app.db

# 图片生成（豆包视觉 / 火山方舟）
# 注意：此 Key 仅在后端使用，绝对不要配置到前端 VITE_* 变量中
DOUBAO_VISION_API_KEY=
DOUBAO_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_VISION_MODEL 为火山方舟推理接入点 ID（ep-xxxxxxxx），需在火山方舟控制台创建图片生成模型接入点
DOUBAO_VISION_MODEL=
IMAGE_OUTPUT_DIR=data/generated_images
IMAGE_TIMEOUT=120
