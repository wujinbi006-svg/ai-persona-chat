# 后端环境变量

# 模式切换
USE_SUPABASE=false

# Supabase（USE_SUPABASE=true 时必填）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 数据库（USE_SUPABASE=true 时填 Supabase PostgreSQL 连接串）
DATABASE_URL=sqlite:///./data/app.db

# LLM API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# CORS（生产环境填前端公网地址，如 https://xxx.vercel.app）
FRONTEND_URL=

# 限流（每分钟每用户最大请求数）
RATE_LIMIT_PER_MINUTE=60

# 上下文
MAX_CONTEXT_MESSAGES=40
LLM_TIMEOUT=120
